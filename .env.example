# All optional. Set these as environment variables (never commit real values).

# Contact email sent to OpenAlex so requests use their faster "polite pool".
OPENALEX_EMAIL=
# Free OpenAlex API key (https://openalex.org) for higher daily limits.
OPENALEX_API_KEY=
# Free Semantic Scholar API key (https://www.semanticscholar.org/product/api) — avoids shared-pool throttling.
S2_API_KEY=

# Free NCBI key (https://www.ncbi.nlm.nih.gov/account/) raises PubMed's limit from 3 to 10 requests/second.
NCBI_API_KEY=
# Contact email sent to NCBI with PubMed requests (defaults to OPENALEX_EMAIL).
NCBI_EMAIL=

# Anthropic API key — enables the optional "Get AI review" button (Claude Opus 5.5).
# Each review costs roughly $0.05–0.10. Leave empty to disable AI review.
ANTHROPIC_API_KEY=
# Maximum AI reviews per day (whole server) and per visitor IP per minute.
AI_REVIEW_DAILY_LIMIT=200
AI_REVIEW_PER_MINUTE=6

# Hostnames this server will answer to (comma separated). Set to your domain when deploying.
ALLOWED_HOSTS=localhost,127.0.0.1
# Searches allowed per client IP per minute.
RATE_LIMIT_PER_MINUTE=30
